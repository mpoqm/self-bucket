{
    "version": "5.0.7",
    "description": "多人一起观影、听歌、语音聊天和屏幕分享平台。",
    "homepage": "https://github.com/Zero-wyc/ZViewer",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Zero-wyc/ZViewer/releases/download/v5.0.7/zviewer-windows-x64.zip",
            "hash": "8aec0be74e291ae72cb854c4bbea54f7482605f944d5a23422636ddb16e18ddc"
        }
    },
    "persist": "config",
    "installer": {
        "script": [
            "$wrapper = @'
@echo off
setlocal
set \"CONFIG_DIR=%~dp0config\"
set \"DATABASE_URL=%CONFIG_DIR%\\dev.sqlite\"
set \"UPLOADS_DIR=%CONFIG_DIR%\\uploads\"
set \"AVATARS_DIR=%CONFIG_DIR%\\uploads\\avatars\"
set \"MEDIA_DIR=%CONFIG_DIR%\\media\"
call \"%~dp0start.bat\" %*
endlocal
'@",
            "Set-Content -LiteralPath (Join-Path $dir 'zviewer-scoop.cmd') -Value $wrapper -Encoding ASCII"
        ]
    },
    "bin": [
        [
            "zviewer-scoop.cmd",
            "zviewer"
        ]
    ],
    "shortcuts": [
        [
            "zviewer-scoop.cmd",
            "ZViewer",
            "start"
        ]
    ],
    "checkver": {
        "github": "https://github.com/Zero-wyc/ZViewer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Zero-wyc/ZViewer/releases/download/v$version/zviewer-windows-x64.zip"
            }
        }
    }
}
