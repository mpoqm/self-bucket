{
    "version": "0.6.12",
    "description": "Cross-platform desktop application that turns documents into an organized, interlinked knowledge base.",
    "homepage": "https://github.com/nashsu/llm_wiki",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nashsu/llm_wiki/releases/download/v0.6.12/LLM-Wiki-0.6.12-windows-x64-portable.zip",
            "hash": "1904eab178e6f06891f3e0c865f99d97c6183e08d1764936462215a9ce81c8ce"
        }
    },
    "installer": {
        "script": [
            "ensure \"$persist_dir\" | Out-Null",
            "$appData = \"$env:APPDATA\\com.llmwiki.app\"",
            "if (Test-Path \"$appData\") {",
            "    if ((Get-Item \"$appData\" -Force).LinkType -ne 'Junction') { throw \"Existing application data found at $appData; move it to $persist_dir manually before installing.\" }",
            "} else {",
            "    New-Item -ItemType Junction -Path \"$appData\" -Target \"$persist_dir\" | Out-Null",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$appData = \"$env:APPDATA\\com.llmwiki.app\"",
            "if ((Test-Path \"$appData\") -and ((Get-Item \"$appData\" -Force).LinkType -eq 'Junction')) { Remove-Item \"$appData\" -Force }"
        ]
    },
    "shortcuts": [
        [
            "LLM Wiki.exe",
            "LLM Wiki"
        ]
    ],
    "checkver": {
        "github": "https://github.com/nashsu/llm_wiki"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nashsu/llm_wiki/releases/download/v$version/LLM-Wiki-$version-windows-x64-portable.zip"
            }
        }
    }
}
